			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1774955497858</Id>
					<Name><![CDATA[getShortestQueueIndex]]></Name>
					<X>30</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] sizes = { queue1.size(), queue2.size(), queue3.size(), queue4.size(), queue5.size(), queue6.size() };
int minSize = sizes[0];
for(int s : sizes) if(s < minSize) minSize = s;

java.util.ArrayList<Integer> targets = new java.util.ArrayList<>();
for(int i = 0; i < sizes.length; i++) {
    if(sizes[i] == minSize) targets.add(i + 1);
}
return targets.get(uniform_discr(0, targets.size() - 1));]]></Body>
				</Function>
			</Functions>
