							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double t = time();
if (t > 0 && source.count() > 0) {

    inRate_M = source.count() / t;
    outRate_M = n * mu; 

    traffic_M = inRate_M / mu;
    trafficPerChannel_M = traffic_M / n;

    p0_M = 1 - delay.statsUtilization.mean();
    p_otk_M = (double) sinkRejected.count() / source.count();

    Q_M = (double) sinkServed.count() / source.count();
    A_M = sinkServed.count() / t;

    Int_reject_M = sinkRejected.count() / t;

    L_q_M = queue.statsSize.mean();
	L_srv_M = delay.statsUtilization.mean();
    L_sys_M = L_q_M + L_srv_M;

    W_q_M = timeQEnd.distribution.mean();
    W_srv_M = timeSrvEnd.distribution.mean();
    W_sys_M = timeSysEnd.distribution.mean();
}]]></Action>
				</Event>
